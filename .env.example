# ─────────────────────────────────────────────────────────────
# Sunit Jadhav Website — Environment Variables
# Copy this file to .env.local for local development,
# or add these to your Vercel project's Environment Variables.
# ─────────────────────────────────────────────────────────────

# Recipient email addresses
CONTACT_EMAIL=contact@sunitjadhav.com
BRAND_ENQUIRY_EMAIL=brands@sunitjadhav.com

# SMTP configuration (works with Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-app-password

# Gmail note: generate an App Password at
# https://myaccount.google.com/apppasswords
# (requires 2-factor auth to be enabled)
